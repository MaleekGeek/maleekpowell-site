---
layout: layouts/base.njk
---
<article class="event">
  <header class="event__head">
    <p class="event__date" data-reveal><time datetime="{{ page.date | isoDate }}"><span class="event__day">{{ page.date | dayNum }}</span><span class="event__mon">{{ page.date | monthShort }}</span></time></p>
    <div>
      <p class="post__meta" data-reveal><span>{{ kind }}</span>{% if time %} · {{ time | withZone }}{% endif %}{% if place %} · {{ place }}{% endif %}</p>
      <h1 data-reveal style="--i:1">{% if sample %}[Sample] {% endif %}{{ title }}</h1>
      {% if summary %}<p class="post__lead" data-reveal style="--i:2">{{ summary }}</p>{% endif %}
      {% if link %}<a class="pill" href="{{ link }}" rel="noopener" target="_blank" data-reveal style="--i:3">Save my spot</a>{% endif %}
    </div>
  </header>
  <div class="post__body prose">
    {{ content | safe }}
  </div>
  <footer class="post__foot">
    <a class="arrow-link" href="/events/">See all events <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M2 11h17M13 5l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none"/></svg></a>
  </footer>
</article>
