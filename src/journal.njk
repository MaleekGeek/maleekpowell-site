---
layout: layouts/base.njk
title: Journal
description: Updates, insights, tips and news from Maleek Powell.
permalink: /journal/
---
{% from "partials/macros.njk" import slot with context %}
{% set cats = [
  ["Update", "What's new, what I'm working on, and what's coming."],
  ["Insight", "Something I noticed or learned, and what I'm doing about it."],
  ["Tips & tricks", "One small thing you can try today."],
  ["News", "Something happening that's worth knowing about, and what it means for your day-to-day."]
] %}
<section class="page-head">
  <h1 data-reveal>Journal</h1>
  <p class="intro-line" data-reveal style="--i:1">Not everything needs a video. This is where I write the rest down: what I'm working on, what I've figured out, and little things that help.</p>
</section>
<section class="section" aria-labelledby="posts-h">
  <h2 id="posts-h" class="sr-only">All posts</h2>
  <div class="chips" role="group" aria-label="Filter posts">
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    {% for c in cats %}<button type="button" data-filter="{{ c[0] }}" data-note="{{ c[1] }}" aria-pressed="false">{{ c[0] }}</button>
    {% endfor %}
  </div>
  <p class="chip-note" aria-live="polite" hidden></p>
  <div class="cards" aria-live="polite">
    {% for p in collections.journal %}
    <a class="vcard pcard" href="{{ p.url }}" data-kind="{{ p.data.category }}" data-reveal style="--i:{{ loop.index0 % 3 }}">
      {{ slot("span", "thumb", "Cover photo", p.data.cover, "") }}
      <span class="meta"><span>{{ p.data.category }}</span><span>{{ p.date | readableDate }}</span></span>
      <h3>{% if p.data.sample %}[Sample] {% endif %}{{ p.data.title }}</h3>
      <p>{{ p.data.summary }}</p>
    </a>
    {% endfor %}
  </div>
  <p class="empty"{% if collections.journal | length %} hidden{% endif %}>Nothing written yet. Give me a minute.</p>
</section>
